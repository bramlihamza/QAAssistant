# QA Assistant — Vercel Deployment

# ── OpenAI API ───────────────────────────────────────────────────────
# Créez une clé ici: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxx

# ── LLM Configuration ────────────────────────────────────────────────
MODEL=gpt-4o-mini
TEMPERATURE=0
MAX_TOKENS=2048

# ── Pinecone (remplace ChromaDB local) ───────────────────────────────
# Gratuit: https://www.pinecone.io/
# 1. Créez un compte gratuit (1 index, 100k vectors)
# 2. Créez un index nommé "qa-assistant"
# 3. Récupérez la clé API et l'environnement

PINECONE_API_KEY=pcak_xxxxxxxxxxxxxxxxxxxx
PINECONE_INDEX=qa-assistant
PINECONE_ENVIRONMENT=gcp-starter

# ── RAG (optionnel) ──────────────────────────────────────────────────
RAG_RERANKER_ENABLED=false
EMBEDDING_MODEL=text-embedding-3-small

# ── Évaluation RAGAS (optionnel) ─────────────────────────────────────
RAGAS_ENABLED=false

# Note: Les PDFs ISTQB doivent être indexés une seule fois dans Pinecone
