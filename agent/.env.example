# Clé API OpenAI
OPENAI_API_KEY=sk-...

# Modèle LLM
MODEL=gpt-4o-mini

# Température (0 = déterministe)
TEMPERATURE=0

# Nombre maximum de tokens en sortie
MAX_TOKENS=2048

# Modèle d'embeddings OpenAI
EMBEDDING_MODEL=text-embedding-3-small

# RAG — chemin vers les PDFs ISTQB (relatif au répertoire agent/)
ISTQB_DOCS_DIR=../pdf

# RAG — nom de la collection ChromaDB
CHROMA_COLLECTION=istqb_best_practices

# Endpoint REST des user stories (GET → tableau JSON)
US_API_ENDPOINT=http://localhost:3000/api/user-stories

# ChromaDB : chemin de persistance locale
CHROMA_PERSIST_DIR=./chroma_db

# Seuil de score RAG minimum — calibré pour text-embedding-3-small + ISTQB
# Les scores cosinus sur documents techniques plafonnent à ~0.25
# Valeur recommandée : 0.10 (filtre le bruit) à 0.15 (plus sélectif)
RAG_SCORE_THRESHOLD=0.10

# Nombre de chunks RAG récupérés
RAG_TOP_K=5
